TURSO_DATABASE_URL=libsql://opencode-usage-<org>.turso.io
TURSO_AUTH_TOKEN=<token>
TAVILY_API_KEY=<tavily api key>
# Exa Team Management *service* key (dashboard.exa.ai → API Keys → Service keys).
# A search API key from the API Keys tab will return Unauthorized.
EXA_API_KEY=<exa service key>
# Optional. If unset, the first key returned by Exa's team-management API is used.
# EXA_API_KEY_ID=<uuid>
# Alias accepted if you already name it this way:
# EXA_SERVICE_KEY=<exa service key>
